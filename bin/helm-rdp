#!/usr/bin/python3
"""Helm Remote Desktop launcher."""
import os
import sys

sys.dont_write_bytecode = True  # never write into /opt/helm-rdp

# Installed layout: /opt/helm-rdp/helm_rdp ; dev layout: repo root (bin/..).
here = os.path.dirname(os.path.realpath(__file__))
for path in (os.path.join(here, ".."), "/opt/helm-rdp"):
    path = os.path.abspath(path)
    if os.path.isdir(os.path.join(path, "helm_rdp")):
        if path not in sys.path:
            sys.path.insert(0, path)
        break

from helm_rdp.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
